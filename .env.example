# Copia a .env (o corre ./scripts/setup.sh, que genera los secretos por ti)

# Contraseña de la base de datos (solo la usan los contenedores)
POSTGRES_PASSWORD=
# Llave del servidor, al menos 32 bytes en base64: openssl rand -base64 32
# Cifra los secretos 2FA. Si la pierdes, los usuarios con 2FA tendrán que usar códigos de respaldo.
SERVER_SECRET=

# Registro inicial (el administrador lo puede cambiar después en Ajustes):
# invite: solo con invitación del administrador · open: cualquiera puede crear cuenta
REGISTRATION=invite

# Correo para mandar las invitaciones (opcional). Sin SMTP, la app te da el enlace para compartirlo.
# Gmail: smtp.gmail.com, puerto 587, tu correo y una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords; requiere la verificación en dos pasos de Google).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente, por ejemplo: PassMe <tu-correo@gmail.com>
SMTP_FROM=
# Dirección pública para los enlaces de los correos (https://passme.tudominio.com). Si se deja vacía
# se usa la dirección desde la que el administrador abrió la app (sirve con túneles que cambian).
PUBLIC_URL=

# Puerto HTTPS publicado en el servidor
PASSME_PORT=4040
# Nombre del certificado autofirmado que se genera si ./certs está vacío
PASSME_CERT_CN=passme.local

# Intentos por minuto y por IP en login, 2FA y recuperación
AUTH_RATE_LIMIT=10
# Días que dura una sesión antes de pedir login de nuevo
SESSION_TTL_DAYS=14
