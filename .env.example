# Copia a .env (o corre ./scripts/setup.sh, que genera los secretos por ti)

# Contraseña de la base de datos (solo la usan los contenedores)
POSTGRES_PASSWORD=
# Llave del servidor, al menos 32 bytes en base64: openssl rand -base64 32
# Cifra los secretos 2FA. Si la pierdes, los usuarios con 2FA tendrán que usar códigos de respaldo.
SERVER_SECRET=

# open: cualquiera puede crear cuenta · closed: solo la primera cuenta (administrador)
REGISTRATION=closed

# Puerto HTTPS publicado en el servidor
PASSME_PORT=4040
# Nombre del certificado autofirmado que se genera si ./certs está vacío
PASSME_CERT_CN=passme.local

# Intentos por minuto y por IP en login, 2FA y recuperación
AUTH_RATE_LIMIT=10
# Días que dura una sesión antes de pedir login de nuevo
SESSION_TTL_DAYS=14
